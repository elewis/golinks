{
  "name": "GoLinks",
  "version": "0.0.1",
  "description": "In-browser implementation of go/ links (example: go/github).",
  "manifest_version": 3,
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Add go link",
    "default_popup": "popup.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+G" },
      "description": "Add a go link"
    }
  },
  "permissions": ["activeTab", "declarativeNetRequestWithHostAccess", "storage"],
  "host_permissions": ["http://go/", "https://go/"]
}
