{
  "name": "GoLinks",
  "version": "0.0.1",
  "description": "In-browser implementation of go/ links (example: go/github).",
  "manifest_version": 3,
  "browser_specific_settings": {
    "gecko": {
      "id": "golinks@ethanlew.is"
    }
  },
  "background": {
    "scripts": ["api.js", "links.js", "rules.js", "search.js", "background.js"]
  },
  "action": {
    "default_title": "Add go link",
    "default_popup": "popup.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+G" },
      "description": "Add a go link"
    }
  },
  "permissions": ["activeTab", "declarativeNetRequestWithHostAccess", "storage", "webRequest", "webRequestBlocking"],
  "host_permissions": ["*://go/*", "*://*/*"],
  "web_accessible_resources": [
    {
      "resources": ["index.html", "notfound.html"],
      "matches": ["*://go/*"]
    }
  ]
}
