{
  "name": "GoLinks",
  "version": "0.0.1",
  "description": "In-browser implementation of go/ links (example: go/github).",
  "manifest_version": 3,
  "browser_specific_settings": {
    "gecko": {
      "id": "golinks@ethanlew.is"
    }
  },
  "background": {
    "scripts": ["links.js", "background.js"]
  },
  "permissions": [
    "declarativeNetRequestWithHostAccess",
    "storage",
    "webRequest",
    "webRequestBlocking"
  ],
  "host_permissions": [
    "*://go/*",
    "*://*.google.com/*",
    "*://*.bing.com/*",
    "*://*.duckduckgo.com/*",
    "*://*.search.yahoo.com/*",
    "*://*.ecosia.org/*",
    "*://*.startpage.com/*",
    "*://*.search.brave.com/*",
    "*://*.qwant.com/*",
    "*://*.kagi.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["index.html", "notfound.html"],
      "matches": ["*://go/*"]
    }
  ]
}